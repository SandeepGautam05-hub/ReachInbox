# ReachInbox Email Scheduler Environment Template

# Server & Runtime
PORT=5000
NODE_ENV=development

# Database (SQLite default for zero-config run, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis (External or leave blank for automatic embedded Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Throughput, Throttling & Rate Limiting
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Google OAuth (Optional: leaving blank enables instant one-click demo login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET="reachinbox-jwt-secret-key-2026"

# Slack OAuth & Live Rate-Limit Notifications
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/callback"
SLACK_DEFAULT_WEBHOOK_URL=""

# Elasticsearch (Optional)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_ENABLED=false
